{
  "name": "workcred",
  "version": "1.0.0",
  "description": "Proof of work, work near you. Mobile-first PWA for verified daily-wage work history and local hiring.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "dev:backend": "npm run dev",
    "start:backend": "npm run start",
    "start:lan": "node backend/src/server.js --lan",
    "open": "node scripts/open.mjs",
    "seed": "npm --prefix backend run seed",
    "seed:reset": "npm --prefix backend run seed:reset",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:snapshot": "node scripts/demo-snapshot.mjs",
    "demo:restore": "node scripts/demo-restore.mjs",
    "test": "node --test tests/**/*.test.js",
    "test:backend": "npm --prefix backend run test",
    "test:all": "npm test && npm run test:backend",
    "db:indexes": "npm --prefix backend run db:indexes",
    "gen:secrets": "npm --prefix backend run gen:secrets",
    "https:help": "node scripts/https-help.mjs",
    "lint": "eslint frontend/js/*.js frontend/app/js/**/*.js shared/constants.js shared/*.js tests/**/*.js",
    "lint:tokens": "node scripts/lint-tokens.js",
    "format": "prettier --write \"frontend/**/*.{html,css,js}\" \"shared/**/*.js\" \"docs/**/*.md\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "workcred",
    "pwa",
    "marketplace",
    "proof-of-work"
  ],
  "author": "WorkCred Team",
  "license": "ISC",
  "dependencies": {
    "gsap": "^3.12.5",
    "lenis": "^1.1.20"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "http-server": "^14.1.1",
    "prettier": "^3.5.0"
  }
}
