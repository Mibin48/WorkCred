{
  "name": "workcred-backend",
  "version": "1.0.0",
  "description": "WorkCred REST API and MongoDB backend service",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "seed": "node src/seed/index.js",
    "seed:reset": "node src/seed/index.js --reset",
    "db:indexes": "node -e \"import('./src/models/index.js').then(m => m.ensureIndexes().then(() => { console.log('Indexes synced'); process.exit(0); }))\"",
    "gen:secrets": "node scripts/gen-secrets.js"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.12",
    "mongoose": "^8.10.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.4"
  }
}
