# WorkCred Backend Configuration

# Node environment: development | production | test
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000

# MongoDB Atlas Connection String (Must include the database name '/workcred')
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/workcred?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/workcred?retryWrites=true&w=majority

# Optional: Test database URI for running tests against Atlas (Must end with '_test', e.g., '/workcred_test')
# TEST_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/workcred_test?retryWrites=true&w=majority

# Authentication & JWT Secrets (Run `npm run gen:secrets` to generate strong random values)
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_random_access_secret_key_here
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_random_refresh_secret_key_here

# Booking Handshake Codes AES-256-GCM Encryption Key (Base64 encoded 32 bytes / 256 bits)
CODES_ENC_KEY=replace_with_32_bytes_base64_encoded_encryption_key_here==

# OTP Configuration
# OTP_MODE: 'dev' for fixed code (allowed only in development/test), 'sms' for live provider
OTP_MODE=dev
OTP_DEV_CODE=123456

# SMS Provider Placeholders (Phase B Step 10+)
SMS_PROVIDER=placeholder
SMS_API_KEY=placeholder

# Cloudinary Storage Placeholders (Phase B Step 12+)
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

# Logging & Proxy Settings
LOG_LEVEL=info
TRUST_PROXY=false
